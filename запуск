--==================================================

local BREAST_SIZE = Vector3.new(1.8, 1.6, 1.4)
local BREAST_LOWER_SIZE = Vector3.new(1.4, 1.0, 1.1)
local BREAST_OFFSET_X = 0.7
local BREAST_OFFSET_Y = 0.05
local BREAST_OFFSET_Z = -0.55
local BREAST_LOWER_OFFSET_Y = -0.35
local BREAST_LOWER_OFFSET_Z = 0.15

local NIPPLE_SIZE = Vector3.new(0.25, 0.2, 0.2)
local NIPPLE_OFFSET_X = 0.7
local NIPPLE_OFFSET_Y = -0.15
local NIPPLE_OFFSET_Z = -0.75
local NIPPLE_COLOR = Color3.fromRGB(200, 130, 140)

local BUTT_SIZE = Vector3.new(1.6, 1.7, 1.5)
local BUTT_LOWER_SIZE = Vector3.new(1.4, 1.3, 1.2)
local BUTT_OFFSET_X = 0.7
local BUTT_OFFSET_Y = -0.15
local BUTT_OFFSET_Z = 0.55
local BUTT_LOWER_OFFSET_Y = -0.35
local BUTT_LOWER_OFFSET_Z = -0.10

