local function toggleLeraMode()
	if not spawnedNpc
		or animatingClothing
	then
		return
	end

	isImproved =
		not isImproved

	if isImproved then
		if regularShirt then
			regularShirt:Destroy()
			regularShirt = nil
		end

		if regularPants then
			regularPants:Destroy()
			regularPants = nil
		end

		createImprovedClothes()

	else
		animatingClothing =
			true

		for _, entry in ipairs(
			improvedClothing
		) do
			local part =
				entry.part

			if part
				and part.Parent
			then
				if entry.weld then
					entry.weld:Destroy()
				end

				part.Anchored =
					true

				local tween =
					TweenService:Create(
						part,
						TweenInfo.new(
							0.55,
							Enum.EasingStyle.Quad,
							Enum.EasingDirection.In
						),
						{
							Position =
								part.Position
								+ Vector3.new(
									0,
									-4,
									0
								),

							Transparency =
								1
						}
					)

				tween:Play()

				tween.Completed:Connect(
					function()
						if part
							and part.Parent
						then
							part:Destroy()
						end
					end
				)
			end
		end

		task.wait(
			0.6
		)

		improvedClothing =
			{}

		createRegularClothes()

		animatingClothing =
			false
	end
end

local function updateScales()
	if not spawnedNpc then
		return
	end

	for _, part in ipairs(
		bodyParts
	) do
		if part
			and part.Parent
		then
			local name =
				part.Name

			if string.find(
				name,
				"BreastTop"
			) then

				part.Size =
					BREAST_TOP_BASE
					* breastScale

			elseif string.find(
				name,
				"BreastMain"
			) then

				part.Size =
					BREAST_MAIN_BASE
					* breastScale

			elseif string.find(
				name,
				"BreastLower"
			) then

				part.Size =
					BREAST_LOWER_BASE
					* breastScale

			elseif string.find(
				name,
				"Nipple"
			) then

				part.Size =
					Vector3.new(
						0.23,
						0.23,
						0.17
					)
					* breastScale

			elseif string.find(
				name,
				"ButtTop"
			) then

				part.Size =
					BUTT_TOP_BASE
					* buttScale

			elseif string.find(
				name,
				"ButtMain"
			) then

				part.Size =
					BUTT_MAIN_BASE
					* buttScale

			elseif string.find(
				name,
				"ButtLower"
			) then

				part.Size =
					BUTT_LOWER_BASE
					* buttScale
			end
		end
	end

	if isImproved then
		createImprovedClothes()
	end
end

local function setPlayerVisible(
	visible
)
	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	for _, object in ipairs(
		character:GetDescendants()
	) do
		if object:IsA(
			"BasePart"
		) then

			object.LocalTransparencyModifier =
				visible
				and 0
				or 1

		elseif object:IsA(
			"Decal"
		) then

			object.Transparency =
				visible
				and 0
				or 1
		end
	end
end

local function togglePossess()
	if not spawnedNpc then
		return
	end

	local character =
		LocalPlayer.Character

	if not character then
		return
	end

	local playerRoot =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	local npcRoot =
		spawnedNpc:FindFirstChild(
			"HumanoidRootPart"
		)

	local playerHumanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not playerRoot
		or not npcRoot
		or not playerHumanoid
	then
		return
	end

	isPossessing =
		not isPossessing

	if isPossessing then
		setPlayerVisible(
			false
		)

		npcRoot.CFrame =
			playerRoot.CFrame

		possessWeld =
			Instance.new(
				"WeldConstraint"
			)

		possessWeld.Part0 =
			playerRoot

		possessWeld.Part1 =
			npcRoot

		possessWeld.Parent =
			npcRoot

		local npcHumanoid =
			spawnedNpc:
			FindFirstChildOfClass(
				"Humanoid"
			)

		if npcHumanoid then
			npcHumanoid:
				ChangeState(
					Enum.HumanoidStateType.
					Physics
				)
		end

		workspace.CurrentCamera.
			CameraSubject =
			playerHumanoid

	else
		setPlayerVisible(
			true
		)

		if possessWeld then
			possessWeld:Destroy()
			possessWeld = nil
		end

		workspace.CurrentCamera.
			CameraSubject =
			playerHumanoid
	end
end

local function createNpc(
	position
)
	if spawnedNpc then
		spawnedNpc:Destroy()
	end

	bodyParts = {}
	improvedClothing = {}

	local description =
		Instance.new(
			"HumanoidDescription"
		)

	description.BodyTypeScale =
		0.65

	description.HeightScale =
		0.98

	description.WidthScale =
		0.84

	description.ProportionScale =
		0.45

	description.HeadScale =
		0.95

	description.Face =
		CONFIG.faceId

	description.HairAccessory =
		tostring(
			CONFIG.hairId
		)

	local npc =
		Players:
		CreateHumanoidModelFromDescription(
			description,
			Enum.HumanoidRigType.R15
		)

	npc.Name =
		CONFIG.name

	npc.Parent =
		workspace

	spawnedNpc =
		npc

	for _, child in ipairs(
		npc:GetChildren()
	) do
		if child:IsA(
			"Shirt"
		)
		or child:IsA(
			"Pants"
		)
		then
			child:Destroy()
		end
	end

	for _, object in ipairs(
		npc:GetDescendants()
	) do
		if object:IsA(
			"BasePart"
		)
		and object.Name
			~= "HumanoidRootPart"
		then

			object.Color =
				CONFIG.skinColor
		end
	end

	createBodyShape(
		npc
	)

	createImprovedClothes()

	isImproved =
		true

	local humanoid =
		npc:FindFirstChildOfClass(
			"Humanoid"
		)

	if humanoid then
		humanoid.DisplayName =
			CONFIG.name

		humanoid.WalkSpeed =
			0

		humanoid.JumpPower =
			0
	end

	npc:PivotTo(
		CFrame.new(
			position
		)
	)

	return npc
end

