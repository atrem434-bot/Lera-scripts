		)

	local buttPlus =
		button(
			"Попа +",
			302,
			Color3.fromRGB(
				70,
				70,
				85
			)
		)

	spawnButton.
		MouseButton1Click:
		Connect(
			function()
				local character =
					LocalPlayer.Character

				if not character then
					return
				end

				local root =
					character:
					FindFirstChild(
						"HumanoidRootPart"
					)

				if not root then
					return
				end

				createNpc(
					(
						root.CFrame
						* CFrame.new(
							0,
							0,
							-6
						)
					).Position
				)
			end
		)

	modeButton.
		MouseButton1Click:
		Connect(
			function()
				toggleLeraMode()

				if isImproved then
					modeButton.Text =
						"раздеть леру"
				else
					modeButton.Text =
						"одеть леру"
				end
			end
		)

	possessButton.
		MouseButton1Click:
		Connect(
			function()
				togglePossess()

				if isPossessing then
					possessButton.Text =
						"🎮 Выйти из Леры"
				else
					possessButton.Text =
						"🎮 Играть за Леру"
				end
			end
		)

	breastMinus.
		MouseButton1Click:
		Connect(
			function()
				breastScale =
					math.max(
						0.5,
						breastScale
						- 0.1
					)

				updateScales()
			end
		)

	breastPlus.
		MouseButton1Click:
		Connect(
			function()
				breastScale =
					math.min(
						2,
						breastScale
						+ 0.1
					)

				updateScales()
			end
		)

	buttPlus.
		MouseButton1Click:
		Connect(
			function()
				buttScale =
					math.min(
						2,
						buttScale
						+ 0.1
					)

				updateScales()
			end
		)
end

