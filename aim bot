local function updateTeamButtonVisual(team, btn)
	if selectedTeams[team] then
		btn.BackgroundColor3 = Color3.fromRGB(40, 100, 40)
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Color = greenAccent end
	else
		btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		local stroke = btn:FindFirstChildOfClass("UIStroke")
		if stroke then stroke.Color = accent end
	end
end

local function rebuildTeamButtons()
	for _, child in ipairs(teamsScroll:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end

	local list = Teams:GetTeams()
	table.sort(list, function(a, b) return a.Name < b.Name end)

	for i, team in ipairs(list) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, -8, 0, 24)
		btn.LayoutOrder = i
		btn.Text = team.Name
		btn.TextColor3 = Color3.fromRGB(230, 230, 230)
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 12
		btn.AutoButtonColor = false
		btn.Parent = teamsScroll

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = btn

		local stroke = Instance.new("UIStroke")
		stroke.Color = accent
		stroke.Thickness = 1
		stroke.Transparency = 0.5
		stroke.Parent = btn

		updateTeamButtonVisual(team, btn)

		btn.MouseEnter:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 60, 75)}):Play()
		end)
		btn.MouseLeave:Connect(function()
			TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = btn.BackgroundColor3}):Play()
		end)

		btn.MouseButton1Click:Connect(function()
			if selectedTeams[team] then
				selectedTeams[team] = nil
			else
				selectedTeams[team] = true
			end
			updateTeamButtonVisual(team, btn)
		end)
	end
end

Teams.ChildAdded:Connect(rebuildTeamButtons)
