local started = false
local pendingAssignment = {}
local aimEnabled = false
local aimPower = 0.95
local maxDistance = 120

local oldFolder = workspace:FindFirstChild("LocalNPCs")
if oldFolder then oldFolder:Destroy() end

local npcFolder = Instance.new("Folder")
npcFolder.Name = "LocalNPCs"
