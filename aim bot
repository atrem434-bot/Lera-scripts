local function updateTeamButtonVisual(team, btn)
    if selectedTeams[team] then
        btn.BackgroundColor3 = Color3.fromRGB(60, 150, 60)
    else
        btn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    end
end

local function rebuildTeamButtons()
    for _, child in ipairs(teamsScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local list = Teams:GetTeams()
    table.sort(list, function(a, b) return a.Name < b.Name end)

    for i, team in ipairs(list) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.LayoutOrder = i
        btn.Text = team.Name
        btn.TextColor3 = Color3.new(1, 1, 1)
        btn.Parent = teamsScroll
        updateTeamButtonVisual(team, btn)

        btn.MouseButton1Click:Connect(function()
            if selectedTeams[team] then
                selectedTeams[team] = nil
            else
                selectedTeams[team] = true
            end
            updateTeamButtonVisual(team, btn)
        end)
    end
end

Teams.ChildAdded:Connect(rebuildTeamButtons)
Teams.ChildRemoved:Connect(function(team)
    selectedTeams[team] = nil
    rebuildTeamButtons()
end)

rebuildTeamButtons()

task.spawn(function()
    while true do
        task.wait(1)
        counterLabel.Text = "Players: " .. npcCount .. " / " .. MAX_NPC
    end
end)