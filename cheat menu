local function isPlayerCharacter(model)
	return Players:GetPlayerFromCharacter(model) ~= nil
end

local function getTargetPart(model)
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then return head end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then return hrp end
	return nil
end

local function tryRegisterModel(model)
	if trackedNPCs[model] then return end
	if not model:IsA("Model") then return end
	if isPlayerCharacter(model) then return end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	local part = getTargetPart(model)
	if not part then return end

	trackedNPCs[model] = { head = part, humanoid = humanoid }

	humanoid.Died:Connect(function()
		trackedNPCs[model] = nil
		local h = highlights[model]
		if h then h:Destroy(); highlights[model] = nil end
	end)

	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			trackedNPCs[model] = nil
			local h = highlights[model]
			if h then h:Destroy(); highlights[model] = nil end
		end
	end)
end

local function scanWorkspace()
	local count = 0
	for _ in pairs(trackedNPCs) do count += 1 end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if count >= MAX_TRACK then break end
		if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") and not trackedNPCs[obj] and not isPlayerCharacter(obj) then
			tryRegisterModel(obj)
			count += 1
		end
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") then
		task.wait(0.1)
		tryRegisterModel(obj)
	end
end)

local function createHighlight(model)
	local highlight = Instance.new("Highlight")
	highlight.Name = "NPCHighlight"
	highlight.FillColor = Color3.fromRGB(0, 200, 255)
	highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee = model
	highlight.Parent = highlightFolder
	return highlight
end

local function updateHighlights()
	for model, data in pairs(trackedNPCs) do
		if model.Parent and data.head then
			if not highlights[model] then highlights[model] = createHighlight(model) end
			local distance = (camera.CFrame.Position - data.head.Position).Magnitude
			highlights[model].Enabled = aimEnabled and distance <= maxDistance and data.humanoid.Health > 0
		end
	end
	for model, h in pairs(highlights) do
		if not trackedNPCs[model] then h:Destroy(); highlights[model] = nil end
	end
end

local function getTarget()
	local target = nil
	local closest = maxDistance
	for model, data in pairs(trackedNPCs) do
		if model.Parent and data.head and data.humanoid.Health > 0 then
			local dist = (camera.CFrame.Position - data.head.Position).Magnitude
			if dist <= closest then
				closest = dist
				target = data.head
			end
		end
	end
	return target
end

RunService:BindToRenderStep("NPC_AIM_SYSTEM", Enum.RenderPriority.Camera.Value + 1, function()
	updateHighlights()
	if not aimEnabled then return end
	local target = getTarget()
	if target then
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, target.Position), aimPower)
	end
end)

