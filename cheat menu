local function giveTool(name)
	local backpack = player:WaitForChild("Backpack")
	for _, t in pairs(backpack:GetChildren()) do
		if t.Name == name then t:Destroy() end
	end
	local character = player.Character
	if character then
		for _, t in pairs(character:GetChildren()) do
			if t:IsA("Tool") and t.Name == name then t:Destroy() end
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = name
	tool.RequiresHandle = false

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(1, 1, 1)
	handle.Transparency = 1
	handle.CanCollide = false
	handle.Parent = tool

	tool.Equipped:Connect(function(mouse)
		if name == "TP" then
			tpMenu.Visible = true
		end
		mouse.Button1Down:Connect(function()
			local target = mouse.Target
			local hitPos = mouse.Hit and mouse.Hit.Position

			if name == "TP" then
				local hrp = character and character:FindFirstChild("HumanoidRootPart")
				if hrp and hitPos then
					hrp.CFrame = CFrame.new(hitPos + Vector3.new(0, 3, 0))
				end
			elseif name == "Delete" then
				if target then
					target:Destroy()
				end
			end
		end)
	end)

	tool.Parent = backpack
end

