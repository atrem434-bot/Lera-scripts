local function destroyPlatform()
	if platform then
		platform:Destroy()
		platform = nil
	end
end

local function createPlatform(rootPart, humanoid)
	destroyPlatform()
	platform = Instance.new("Part")
	platform.Name = "AirWalkPlatform"
	platform.Size = Vector3.new(6, 1, 6)
	platform.Anchored = true
	platform.CanCollide = true
	platform.CanQuery = false
	platform.Transparency = 1

	local hipHeight = (humanoid and humanoid.HipHeight) or 2
	platformOffset = hipHeight + (rootPart.Size.Y / 2) + (platform.Size.Y / 2) + 0.1

	platformY = rootPart.Position.Y - platformOffset
	platform.Position = Vector3.new(rootPart.Position.X, platformY, rootPart.Position.Z)
	platform.Parent = workspace
end

local function setAirWalk(state)
	airWalkEnabled = state
	updateAirToggleVisual()

	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if state and rootPart then
		createPlatform(rootPart, humanoid)
	else
		destroyPlatform()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end
end

