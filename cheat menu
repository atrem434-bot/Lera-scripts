	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = false
	highlight.Adornee = npc
	highlight.Parent = aimHighlightFolder
	return highlight
end

local function updateAimHighlights()
	for i = 1, MAX_NPC do
		local npc = npcFolder:FindFirstChild(i .. "v")
		if npc then
			local head = npc:FindFirstChild("Head")
			if head and head:IsA("BasePart") then
				if not aimHighlights[npc] then aimHighlights[npc] = createAimHighlight(npc) end
				local distance = (camera.CFrame.Position - head.Position).Magnitude
				aimHighlights[npc].Enabled = aimBotEnabled and distance <= aimBotMaxDistance
			end
		end
	end
	for npc, h in pairs(aimHighlights) do
		if not npc.Parent then h:Destroy(); aimHighlights[npc] = nil end
	end
end

local function getAimTarget()
	local target = nil
	local closest = aimBotMaxDistance
	for _, slot in ipairs(activeSlots) do
		if slot.occupied and slot.head and slot.head.Transparency == 0 then
			local dist = (camera.CFrame.Position - slot.head.Position).Magnitude
			if dist <= aimBotMaxDistance and dist < closest then
				closest = dist
				target = slot.head
			end
		end
	end
	return target
end

RunService:BindToRenderStep("AIMBOT_SYSTEM", Enum.RenderPriority.Camera.Value + 2, function()
	updateAimHighlights()
	if not aimBotEnabled then return end
	local target = getAimTarget()
	if target then
		camera.CFrame = camera.CFrame:Lerp(CFrame.lookAt(camera.CFrame.Position, target.Position), aimBotPower)
	end
end)

