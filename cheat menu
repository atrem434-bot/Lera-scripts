local function refreshPointsList()
	for _, child in pairs(pointsList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for i, point in ipairs(savedPoints) do
		local pointButton = Instance.new("TextButton")
		pointButton.Size = UDim2.new(1, -12, 0, 30)
		pointButton.Text = "Point " .. i
		pointButton.Parent = pointsList
		styleButton(pointButton, accent)

		pointButton.MouseButton1Click:Connect(function()
			local character = player.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.CFrame = CFrame.new(point.x, point.y, point.z)
			end
		end)
	end

	pointsList.CanvasSize = UDim2.new(0, 0, 0, #savedPoints * 36)
end

saveButton.MouseButton1Click:Connect(function()
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if hrp then
		table.insert(savedPoints, {x = hrp.Position.X, y = hrp.Position.Y, z = hrp.Position.Z})
		refreshPointsList()
	end
end)

